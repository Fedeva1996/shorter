generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model UrlEntry {
  id            String    @id @default(uuid())
  originalUrl   String    @unique @db.VarChar(2048)
  shortCode     String    @unique @db.VarChar(6)
  clicks        Int       @default(0)
  createdAt     DateTime  @default(now())
  lastClickedAt DateTime?
}